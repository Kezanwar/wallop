### DB
# Local dev points both at the same Docker Postgres.
# In prod these diverge: POOLED -> Neon pooled endpoint, DIRECT -> Neon direct endpoint.
DATABASE_URL_POOLED=postgres://wallop_user:localdev@localhost:5432/wallop_database
DATABASE_URL_DIRECT=postgres://wallop_user:localdev@localhost:5432/wallop_database
DATABASE_URL_TEST=postgres://wallop_user:localdev@localhost:5432/wallop_test

### GOOGLE
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

### STORAGE (Cloudflare R2)
# Endpoint is derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wallop-dev
# Custom CDN domain for public (non-private/) assets. Leave empty until set up;
# getPublicUrl() throws while it's unset.
R2_PUBLIC_BASE_URL=

### IMAGE PROVIDER (Google Gemini — "Nano Banana 2")
# Needs billing enabled on the Google AI Studio project.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=

### DEV TOOLS
# Default account for `pnpm dev:grant <amount>` (local credit top-ups).
# Dev only — the script refuses to run with NODE_ENV=production.
DEV_GRANT_EMAIL=
